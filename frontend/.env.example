# Copy to frontend/.env.local (gitignored) — or set these in Vercel › Project › Settings › Environment Variables.

# Optional: light control through an MQTT broker (experimental, public broker, no password).
# The topic must be the same long random value as unoq/app/python/mqtt.json on the board.
# Leave VITE_MQTT_TOPIC empty to keep MQTT off (the dashboard then uses NEXUS only).
VITE_MQTT_URL=wss://broker.emqx.io:8084/mqtt
VITE_MQTT_TOPIC=
