# คัดลอกไฟล์นี้เป็น backend/.env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env

# Gemini API key จาก Google AI Studio (Free tier, ยังไม่เปิด Billing)
# ถ้าเว้นว่าง NEXUS ยังทำงานได้เฉพาะ Fast path (คำสั่งชัดเจน เช่น "เปิดไฟ")
GEMINI_API_KEY=

# ชื่อโมเดล — ตรวจรายชื่อที่ใช้ได้จริงด้วย:  python -m nexus models
# และตรวจโควตาฟรีของรุ่นนั้นในหน้า Rate limits ของ AI Studio ก่อนใช้งาน
LLM_MODEL=gemini-flash-lite-latest

# จำนวน request ต่อวันที่ยอมให้ใช้ (ใส่ตามโควตา RPD ที่เห็นใน AI Studio)
# NEXUS จะหยุดเรียก Gemini เองเมื่อถึงจำนวนนี้ เพื่อไม่ให้โดน 429 ซ้ำ ๆ — เว้นว่าง = ไม่จำกัดฝั่งเรา
LLM_DAILY_LIMIT=

# เวลารอคำตอบจาก Gemini (วินาที)
LLM_TIMEOUT_S=20

# โหมดอุปกรณ์: mock (จำลอง) หรือ unoq (Arduino UNO Q — ตั้ง UNOQ_URL / UNOQ_TOKEN ด้านล่าง)
DEVICE_MODE=unoq

# ── Voice (Azure AI Speech, F0 Free tier) ─────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# ภาษาที่ฟังได้ (คั่นด้วย ,) และวิธีแยกภาษา:
#   parallel = ถอดเสียงทุกภาษาพร้อมกันแล้วเลือกที่มั่นใจที่สุด (แม่นกว่า แต่ใช้โควตา STT x จำนวนภาษา)
#   auto     = Azure AutoDetectSourceLanguageConfig (ทดสอบแล้วจัดประโยคไทยสั้น ๆ เป็นอังกฤษผิด 5/8)
STT_LANGUAGES=th-TH,en-US
STT_LANGUAGE_MODE=parallel
# เสียงพูดตอบ — เลือกอัตโนมัติตามภาษาของข้อความ
AZURE_TTS_VOICE_TH=th-TH-NiwatNeural
AZURE_TTS_VOICE_EN=en-US-AndrewNeural
# หมายเลขอุปกรณ์จาก: python voice/test_audio.py --list (เว้นว่าง = ใช้ค่าเริ่มต้นของ Windows)
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# ความเงียบหลังพูด (มิลลิวินาที) ก่อนตัดเป็น 1 ประโยค — น้อย = ตอบไวขึ้น แต่เสี่ยงตัดคนที่หยุดคิดกลางประโยค
VAD_END_SILENCE_MS=600

# เงียบได้นานเท่าไร (วินาที) หลัง NEXUS ตอบ ก่อนกลับไปรอคำว่า "Nexus" — ต่อเวลาให้อัตโนมัติทุกครั้งที่เริ่มพูด
VOICE_SESSION_TIMEOUT_SEC=60

# อุปกรณ์เชื่อมผ่านอะไร: mcp = ผ่าน MCP Server (python -m nexus_mcp, stdio) · local = ในโปรเซสเดียวกัน (ทดสอบ)
DEVICE_BACKEND=mcp

# NEXUS relay ที่บอร์ด UNO Q มา poll (DEVICE_MODE=unoq) — token เดียวกับ relay/.env · ดู unoq/README.md
UNOQ_URL=http://127.0.0.1:8770
UNOQ_TOKEN=
